# Copy to .env for LOCAL DEVELOPMENT and fill in values (never commit .env).
# For Render/production, set these in the dashboard instead; see docs/PRODUCTION.md.

# --- Environment -----------------------------------------------------------
# Leave unset (or "development") locally. "production" enables fail-fast safety checks:
# strong JWT secret, MongoDB required, explicit CORS, persistent mounted DATA_DIR, no demo bootstrap.
# ELEMENTX_ENV=production

# --- Authentication --------------------------------------------------------
# Required in production (>= 32 chars, random). Generate: openssl rand -hex 32
JWT_SECRET=change-me
# Persistent identity database. Optional locally (in-memory dev accounts), REQUIRED in production.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/elementx

# --- Persistent research data (SQLite + original files) --------------------
# Production: both must be absolute and live on the same persistent disk, e.g. on Render:
# DATA_DIR=/var/data
# DATABASE_URL=sqlite:////var/data/elementx.db
# Local defaults: ./data and sqlite:///./data/elementx.db
# SQLITE_BUSY_TIMEOUT_MS=10000

# --- CORS (production: exact frontend origin(s), comma-separated, no wildcard) ---
# CORS_ORIGINS=https://your-frontend.onrender.com

# --- Upload limits (MB) ----------------------------------------------------
# MAX_UPLOAD_MB=50
# MAX_CIF_UPLOAD_MB=5

# --- Materials Project (formula lookups) -----------------------------------
# MP_API_KEY=

# --- Physics Copilot / AI providers (optional; offline stored-records mode without them) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional OpenAI fallback (Gemini is preferred when both are set)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
